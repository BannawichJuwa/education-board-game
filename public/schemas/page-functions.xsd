<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema of the page:* elements used in /sitemap.xml to describe each page and its functions -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="https://eduboard-798471611335.us-central1.run.app/schemas/page-functions"
            xmlns="https://eduboard-798471611335.us-central1.run.app/schemas/page-functions"
            elementFormDefault="qualified">
  <xsd:complexType name="tPage">
    <xsd:sequence>
      <xsd:element name="name" type="xsd:string"/>
      <xsd:element name="type" type="xsd:string"/>
      <xsd:element name="access" type="xsd:string" minOccurs="0"/>
      <xsd:element name="ui" type="xsd:string" minOccurs="0"/>
      <xsd:element name="fr" type="xsd:string" minOccurs="0"/>
      <xsd:element name="function" type="xsd:string" maxOccurs="unbounded"/>
      <xsd:element name="subpage" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:complexContent>
            <xsd:extension base="tPage">
              <xsd:attribute name="path" type="xsd:string" use="required"/>
            </xsd:extension>
          </xsd:complexContent>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="info" type="tPage"/>
  <xsd:element name="everyPage">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="function" type="xsd:string" maxOccurs="unbounded"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
